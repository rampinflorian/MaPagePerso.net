@model Project

@{
    ViewBag.Title = Model.Title;
    Layout = "_Layout";
    var url = string.IsNullOrWhiteSpace(Model.Url) ? null : (Model.Url.StartsWith("http") ? Model.Url : "https://" + Model.Url);
}

<section class="page-head">
    <div class="wrap">
        <span class="kicker">Détail du projet</span>
        <h1>@Model.Title</h1>
    </div>
</section>

<section class="wrap detail">
    <div class="ph">
        <img src="~/images/projects/@Model.Image" alt="Capture du projet @Model.Title">
    </div>
    <div>
        <dl>
            <div><dt>Langage</dt><dd>@Model.Language.Replace("/", " · ")</dd></div>
            <div><dt>Année</dt><dd>@Model.CreatedAt.Year</dd></div>
            @if (url != null)
            {
                <div><dt>Site</dt><dd><a href="@url" target="_blank" rel="noopener">@Model.Url</a></dd></div>
            }
        </dl>
        <p class="muted" style="font-size:18px;margin:0">@Model.Description</p>
    </div>
</section>
