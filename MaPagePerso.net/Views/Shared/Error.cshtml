@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<section class="page-head">
    <div class="wrap">
        <span class="kicker">Erreur</span>
        <h1>Oups, quelque chose s'est mal passé.</h1>
        <p class="muted" style="font-size:19px;max-width:620px;margin:20px 0 32px">Une erreur est survenue pendant le traitement de votre demande.</p>
        @if (Model.ShowRequestId)
        {
            <p class="muted">Identifiant de requête : <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Retour à l'accueil</a>
    </div>
</section>
