@{
    var isHome = ViewContext.RouteData.Values["controller"]?.ToString() == "Home";
    var home = isHome ? "" : Url.Action("Index", "Home");
    var title = string.IsNullOrWhiteSpace(ViewData["Title"]?.ToString())
        ? "Florian Rampin | Développeur de logiciels métier"
        : $"{ViewData["Title"]} | Florian Rampin";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@title</title>
    <meta name="description" content="Florian Rampin, développeur de logiciels métier à Toulon. Parcours, compétences et projets.">
    <meta name="theme-color" content="#FFFFFF">

    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="~/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..800&family=Funnel+Sans:wght@400..700&display=swap" rel="stylesheet">

    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true">
    <script>document.documentElement.classList.add('js')</script>
</head>
<body>

<header class="site-header">
    <div class="wrap nav">
        <a href="@home#top" class="brand" aria-label="Florian Rampin, accueil">
            <img src="~/images/logo-fr.svg" alt="">
            <span class="brand-name">florian rampin<span class="caret" aria-hidden="true"></span></span>
        </a>
        <nav class="nav-links" id="nav-links" aria-label="Navigation principale">
            <a href="@home#about">À propos</a>
            <a href="@home#services">Compétences</a>
            <a href="@home#parcours">Parcours</a>
            <a href="@home#projets">Projets</a>
            <a href="@home#faq">FAQ</a>
        </nav>
        <div class="nav-actions">
            <a href="@home#contact" class="btn btn-dark btn-sm">Me contacter</a>
            <button type="button" class="menu-toggle" aria-controls="nav-links" aria-expanded="false" aria-label="Ouvrir le menu">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
        </div>
    </div>
</header>

<main id="top">
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="wrap">
        <div class="fcols">
            <div>
                <a href="@home#top" class="brand">
                    <img src="~/images/logo-fr.svg" alt="">
                    <span class="brand-name">florian rampin<span class="caret" aria-hidden="true"></span></span>
                </a>
                <p class="muted" style="font-size:15px;margin:14px 0 0;max-width:280px">Développeur de logiciels métier à Toulon.</p>
            </div>
            <div>
                <h4>Navigation</h4>
                <a href="@home#services">Compétences</a>
                <a href="@home#parcours">Parcours</a>
                <a href="@home#projets">Projets</a>
            </div>
            <div>
                <h4>Noovio</h4>
                <a href="https://noovio.fr">noovio.fr</a>
                <a href="https://www.aidalap.fr">aidalap.fr</a>
                <a href="https://pulsemetrics.fr">pulsemetrics.fr</a>
            </div>
            <div>
                <h4>Réseaux</h4>
                <a href="https://github.com/rampinflorian">GitHub</a>
                <a href="https://www.linkedin.com/in/florian-rampin-7070ba162">LinkedIn</a>
                <a href="https://www.facebook.com/florian.rampin.1">Facebook</a>
            </div>
        </div>
        <div class="fbottom">
            <span>© @DateTime.Now.Year Florian Rampin · Noovio</span>
            <span>Fait main en ASP.NET Core</span>
        </div>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
